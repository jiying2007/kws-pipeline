{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jiying2007/kws-pipeline/commercial/target-resource-budget.schema.json",
  "title": "KWS approved physical target resource budget",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "budget_id",
    "sku",
    "board_revision",
    "measurement_contract_id",
    "authority",
    "approved_at_utc",
    "limits"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "approved"},
    "budget_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{3,96}$"},
    "sku": {"type": "string", "minLength": 1, "maxLength": 128},
    "board_revision": {"type": "string", "minLength": 1, "maxLength": 128},
    "measurement_contract_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{3,96}$"},
    "authority": {"type": "string", "minLength": 1, "maxLength": 256},
    "approved_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_cpu_percent",
        "max_rss_kib",
        "max_stack_high_water_bytes",
        "max_temp_c",
        "max_average_power_mw"
      ],
      "properties": {
        "max_cpu_percent": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 100.0},
        "max_rss_kib": {"type": "number", "exclusiveMinimum": 0.0},
        "max_stack_high_water_bytes": {"type": "number", "exclusiveMinimum": 0.0},
        "max_temp_c": {"type": "number"},
        "max_average_power_mw": {"type": "number", "exclusiveMinimum": 0.0}
      }
    }
  }
}
