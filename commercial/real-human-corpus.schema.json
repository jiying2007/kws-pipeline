{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jiying2007/kws-pipeline/commercial/real-human-corpus.schema.json",
  "title": "KWS held-out real-human qualification corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "qualification_id", "deployment_tag", "corpus_role", "recordings"],
  "properties": {
    "schema_version": {"const": 1},
    "qualification_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,63}$"},
    "deployment_tag": {"type": "string", "pattern": "^deployment-[0-9a-f]{12}$"},
    "corpus_role": {"const": "fresh-held-out-qualification"},
    "notes": {"type": "string"},
    "recordings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recording", "input_path", "input_sha256", "input_bytes", "duration_s",
          "speaker_id", "session_id", "source_id", "room_id", "device_id",
          "distance_m", "azimuth_deg", "tags", "expected", "capture", "consent_scope", "retention_class"
        ],
        "properties": {
          "recording": {"type": "string", "minLength": 1},
          "input_path": {"type": "string", "minLength": 1},
          "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "input_bytes": {"type": "integer", "minimum": 1},
          "duration_s": {"type": "number", "exclusiveMinimum": 0},
          "speaker_id": {"type": "string", "minLength": 1},
          "session_id": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "room_id": {"type": "string", "minLength": 1},
          "device_id": {"type": "string", "minLength": 1},
          "distance_m": {"type": "number", "minimum": 0.0, "maximum": 10.0},
          "azimuth_deg": {"type": "number", "minimum": 0.0, "exclusiveMaximum": 360.0},
          "snr_db": {"type": ["number", "null"]},
          "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "expected": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["keyword_id", "start_s", "end_s"],
              "properties": {
                "keyword_id": {"enum": [1, 2]},
                "start_s": {"type": "number", "minimum": 0.0},
                "end_s": {"type": "number", "minimum": 0.0}
              }
            }
          },
          "capture": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sample_rate_hz", "channels", "sample_format"],
            "properties": {
              "sample_rate_hz": {"type": "integer", "minimum": 8000, "maximum": 192000},
              "channels": {"type": "integer", "minimum": 1, "maximum": 16},
              "sample_format": {"const": "pcm_s16le"}
            }
          },
          "consent_scope": {"const": "product-kws-qualification"},
          "retention_class": {"const": "restricted-raw-audio"}
        }
      }
    }
  }
}
