{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jiying2007/kws-pipeline/commercial/real-human-qualification-summary.schema.json",
  "title": "KWS real-human final-AFE qualification summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "phase", "qualified", "shipping_approved", "deployment_tag",
    "qualification_id", "corpus_sha256", "confidence_level", "recordings",
    "positive_speakers", "expected_wakes", "false_rejects", "frr",
    "frr_upper_bound", "negative_audio_hours", "false_accepts_negative",
    "far_per_hour", "far_upper_bound_per_hour", "unexpected_detections_positive",
    "p50_post_end_latency_ms", "p95_post_end_latency_ms", "per_keyword",
    "critical_positive_slices", "afe", "evidence_sha256", "failures", "next_gate"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "phase": {"const": "real-human-final-afe-acoustic-qualification"},
    "qualified": {"type": "boolean"},
    "shipping_approved": {"const": false},
    "deployment_tag": {"type": "string", "pattern": "^deployment-[0-9a-f]{12}$"},
    "qualification_id": {"type": "string", "minLength": 8},
    "corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "confidence_level": {"type": "number", "exclusiveMinimum": 0.5, "exclusiveMaximum": 1.0},
    "recordings": {"type": "integer", "minimum": 1},
    "positive_speakers": {"type": "integer", "minimum": 1},
    "expected_wakes": {"type": "integer", "minimum": 1},
    "false_rejects": {"type": "integer", "minimum": 0},
    "frr": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "frr_upper_bound": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "negative_audio_hours": {"type": "number", "exclusiveMinimum": 0.0},
    "false_accepts_negative": {"type": "integer", "minimum": 0},
    "far_per_hour": {"type": "number", "minimum": 0.0},
    "far_upper_bound_per_hour": {"type": "number", "minimum": 0.0},
    "unexpected_detections_positive": {"type": "integer", "minimum": 0},
    "p50_post_end_latency_ms": {"type": "number", "minimum": 0.0},
    "p95_post_end_latency_ms": {"type": "number", "minimum": 0.0},
    "per_keyword": {"type": "object"},
    "critical_positive_slices": {"type": "object"},
    "afe": {"type": "object"},
    "evidence_sha256": {"type": "object"},
    "failures": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "next_gate": {"enum": ["physical-target-board-performance-and-soak", "real-human-qualification-failed"]}
  }
}
