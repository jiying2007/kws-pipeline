{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native A20 research predictions",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "state_policy": {
      "type": "string",
      "const": "reset_per_asset_preserve_state_within_asset"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "protocol_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decoder_config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "time_basis": {
      "type": "string",
      "const": "audio_timeline_seconds"
    },
    "decision_time_semantics": {
      "type": "string",
      "const": "callback_available_audio_time_not_keyword_end"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "wav_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "pcm_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "complete": {
            "type": "boolean"
          },
          "processed_duration_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "decisions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "keyword": {
                  "type": "string",
                  "minLength": 1
                },
                "decision_time_s": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "id",
                "keyword",
                "decision_time_s"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "asset_id",
          "wav_sha256",
          "pcm_sha256",
          "complete",
          "processed_duration_s",
          "decisions"
        ],
        "additionalProperties": false
      }
    },
    "recorded_resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "cpu_seconds",
              "audio_seconds",
              "wall_seconds",
              "startup_read_bytes",
              "startup_write_bytes",
              "steady_read_bytes",
              "steady_write_bytes",
              "io_syscalls",
              "minor_faults",
              "major_faults",
              "model_storage_bytes",
              "weights_bytes",
              "arena_bytes",
              "cache_included_in_arena_bytes",
              "stack_bytes",
              "peak_rss_bytes",
              "rss_drift_bytes",
              "service_p50_seconds",
              "service_p95_seconds",
              "service_p99_seconds",
              "service_max_seconds",
              "clock_resolution_seconds"
            ]
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "enum": [
              "seconds",
              "bytes",
              "count"
            ]
          },
          "phase": {
            "type": "string",
            "enum": [
              "startup",
              "steady_state",
              "whole_run",
              "static_layout"
            ]
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "sample_count": {
            "type": "integer",
            "minimum": 1
          },
          "correlation_note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "value",
          "unit",
          "phase",
          "evidence_ref",
          "evidence_sha256",
          "environment",
          "sample_count",
          "correlation_note"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "state_policy",
    "manifest_sha256",
    "protocol_sha256",
    "model_sha256",
    "source_sha256",
    "decoder_config_sha256",
    "time_basis",
    "decision_time_semantics",
    "assets",
    "recorded_resources"
  ],
  "additionalProperties": false
}
