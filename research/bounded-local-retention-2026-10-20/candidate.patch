+/* The following policy hook runs once after every detect call, including an
+ * illegal first suffix or no suffix. The candidate copy already exists, and
+ * merge remains unchanged. detect itself keeps its original strong-reset order.
+ */
+static void retention_clear(window *w) {
+    w->anchor_row=KWS3_RETENTION_INACTIVE;
+    w->deadline_row=KWS3_RETENTION_INACTIVE;
+}
+static kws3_status retention_clock(const window *w, int64_t row) {
+    if (w->anchor_row==KWS3_RETENTION_INACTIVE)
+        return w->deadline_row==KWS3_RETENTION_INACTIVE ? KWS3_OK : KWS3_INVARIANT;
+    if (w->anchor_row<0 || w->anchor_row>INT64_MAX-KWS3_RETENTION_ROWS)
+        return KWS3_CLOCK;
+    if (w->deadline_row!=w->anchor_row+KWS3_RETENTION_ROWS ||
+        row<w->anchor_row || row>w->deadline_row) return KWS3_INVARIANT;
+    return KWS3_OK;
+}
+static kws3_status retention_increment(uint64_t *n) {
+    if (*n==UINT64_MAX) return KWS3_CLOCK;
+    ++*n; return KWS3_OK;
+}
+static kws3_status retention_close(state *s, window *w, int64_t row,
+                                   uint64_t *counter, const char *kind) {
+    kws3_status rc;
+    if (!s->retention.active_episodes) return KWS3_INVARIANT;
+    if ((rc=retention_increment(counter))!=KWS3_OK) return rc;
+    --s->retention.active_episodes;
+    /* KWS_DIAG_BEGIN */ KWS_DIAG_WINDOW(kind); /* KWS_DIAG_END */
+    retention_clear(w); return KWS3_OK;
+}
+static kws3_status retention_after_detect(state *s, window *w, int64_t row,
+                                          const kws3_event *e, int activated) {
+    kws3_status rc;
+    if ((rc=retention_clock(w,row))!=KWS3_OK) return rc;
+    if (activated) {
+        if (e->score>=0.7) {
+            /* detect has already advanced last_active_pos and reset once,
+             * irrespective of later dedup/threshold/refractory decisions. */
+            if (w->anchor_row!=KWS3_RETENTION_INACTIVE) {
+                rc=retention_close(s,w,row,&s->retention.strong_closed,
+                                   "retention_strong_closed");
+                if (rc!=KWS3_OK) return rc;
+            }
+        } else if (w->anchor_row==KWS3_RETENTION_INACTIVE) {
+            if (row<0 || row>INT64_MAX-KWS3_RETENTION_ROWS) return KWS3_CLOCK;
+            if (s->retention.active_episodes>=KWS3_WINDOWS) return KWS3_INVARIANT;
+            if ((rc=retention_increment(&s->retention.episodes_started))!=KWS3_OK)
+                return rc;
+            w->anchor_row=row; w->deadline_row=row+KWS3_RETENTION_ROWS;
+            ++s->retention.active_episodes; /* bounded above by three */
+            if (s->retention.active_episodes>s->retention.peak_active_episodes)
+                s->retention.peak_active_episodes=s->retention.active_episodes;
+            /* KWS_DIAG_BEGIN */ KWS_DIAG_WINDOW("retention_started"); /* KWS_DIAG_END */
+        } else {
+            if ((rc=retention_increment(&s->retention.low_repeated))!=KWS3_OK)
+                return rc;
+            /* KWS_DIAG_BEGIN */ KWS_DIAG_WINDOW("retention_low_repeated"); /* KWS_DIAG_END */
+        }
+    }
+    if (w->anchor_row!=KWS3_RETENTION_INACTIVE && row==w->deadline_row) {
+        local_reset(w); /* Deliberately preserve last_active_pos. */
+        rc=retention_close(s,w,row,&s->retention.expired,"retention_expired");
+        if (rc!=KWS3_OK) return rc;
+    }
+    return KWS3_OK;
