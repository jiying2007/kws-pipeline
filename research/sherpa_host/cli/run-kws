#!/bin/sh
# New kws-pipeline host research launcher. Apache-2.0; see LICENSE.
set -eu
# GNU coreutils are the documented Linux host prerequisite. Resolve the launcher
# location without changing the caller's current working directory.
launcher=$(/usr/bin/readlink -f -- "$0") || exit 1
kit_root=${launcher%/*}
if [ ! -f "$kit_root/MANIFEST.sha256" ]; then
    printf '%s\n' 'kws: frozen runtime manifest is missing' >&2
    exit 1
fi
# This is the ONLY explicit chdir, and is confined to this validation subshell.
if ! (
    cd -- "$kit_root" &&
    /usr/bin/env -i PATH=/usr/bin:/bin LC_ALL=C \
        /usr/bin/sha256sum --check --strict --status MANIFEST.sha256
); then
    printf '%s\n' 'kws: frozen runtime integrity check failed' >&2
    exit 1
fi
# The new process gets no inherited LD_LIBRARY_PATH, LD_PRELOAD, LD_AUDIT or
# language/runtime search overrides. This is not a hostile-loader sandbox.
exec /usr/bin/env -i PATH=/usr/bin:/bin LC_ALL=C \
    ORT_DISABLE_TELEMETRY=1 \
    OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 \
    BLIS_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1 NUMEXPR_NUM_THREADS=1 \
    OMP_DYNAMIC=FALSE MKL_DYNAMIC=FALSE \
    "$kit_root/bin/kws" "$@"
