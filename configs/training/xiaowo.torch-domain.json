{
  "schema_version": 1,
  "name": "xiaowo-torch-domain-iteration-v1",
  "seed": 1337,
  "tokens": "keywords/tokens.example.txt",
  "keywords": "keywords/zh_cn_example.tsv",
  "domain_work_dir": "build/model-training",
  "generator": {
    "continuous_gap_ms": 1600.0,
    "tts": {
      "backend": "tone",
      "token_ms": 180.0,
      "token_ms_jitter": 18.0,
      "gap_ms": 85.0,
      "lead_ms": 180.0,
      "tail_ms": 200.0,
      "amplitude": 12500.0,
      "pitch_jitter": 0.006
    },
    "augment": {
      "gain_db_min": -3.0,
      "gain_db_max": 2.0,
      "snr_db_min": 10.0,
      "snr_db_max": 36.0,
      "echo_max_ms": 35.0,
      "echo_gain_max": 0.10,
      "noise_profiles": ["white", "fan", "motor", "media"]
    }
  },
  "dataset": {
    "train": {
      "positive_families_per_keyword": 3,
      "confusable_families_per_keyword": 2,
      "random_negative_families": 4,
      "background_seconds_per_profile": 1.0,
      "variants_per_family": 2
    },
    "calibration": {
      "positive_families_per_keyword": 2,
      "confusable_families_per_keyword": 2,
      "random_negative_families": 4,
      "background_seconds_per_profile": 2.0,
      "variants_per_family": 1
    },
    "test": {
      "positive_families_per_keyword": 2,
      "confusable_families_per_keyword": 2,
      "random_negative_families": 4,
      "background_seconds_per_profile": 3.0,
      "variants_per_family": 1
    },
    "qualification": {
      "positive_families_per_keyword": 3,
      "confusable_families_per_keyword": 3,
      "random_negative_families": 6,
      "background_seconds_per_profile": 10.0,
      "variants_per_family": 1
    }
  },
  "domains": {
    "distance_bands": {
      "near": {"distance_m": [0.3, 1.0], "weight": 1.0},
      "mid": {"distance_m": [1.0, 3.0], "weight": 1.5},
      "far": {"distance_m": [3.0, 5.0], "weight": 2.5}
    },
    "azimuth_deg": [-90, -60, -30, 0, 30, 60, 90, 180],
    "rt60_s": [0.15, 0.80],
    "snr_db": [5.0, 30.0],
    "noise_profiles": ["white", "fan", "motor", "media"],
    "mic_spacing_m": 0.06,
    "playback": {
      "probability": 0.25,
      "sir_db": [-5.0, 20.0]
    },
    "afe": {
      "backend": "proxy"
    },
    "scenes_per_example": {
      "train": 2,
      "calibration": 1,
      "test": 1,
      "qualification": 1
    }
  },
  "model": {
    "feature_dim": 32,
    "hidden_dim": 48,
    "frontends": ["logmel", "pcen-lite"],
    "domain_variants_per_token": 16,
    "prototype_candidates": [
      {"input_scale": 0.010, "output_scale": 0.050, "blank_bias": 1.8, "token_bias": -1.2}
    ]
  },
  "train": {
    "epochs": 4,
    "batch_size": 16,
    "lr": 0.001
  },
  "calibration": {
    "thresholds": [0.25, 0.40, 0.55, 0.70, 0.85],
    "coordinate_rounds": 1
  },
  "domain_iteration": {
    "backend": "torch_ctc",
    "max_rounds": 3,
    "min_rounds": 3,
    "patience": 3,
    "curriculum_strength": 2.5,
    "max_domain_weight": 6.0,
    "stop_on_gate": false
  },
  "domain_gates": {
    "max_frr": 0.05,
    "max_far_per_hour": 0.0,
    "max_p95_latency_ms": 800.0,
    "max_far_frr": 0.08
  }
}
