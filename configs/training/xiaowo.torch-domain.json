{
  "schema_version": 1,
  "name": "xiaowo-torch-domain-iteration-v1",
  "seed": 1337,
  "tokens": "keywords/tokens.example.txt",
  "keywords": "keywords/zh_cn_example.tsv",
  "domain_work_dir": "build/model-training",
  "generator": {
    "continuous_gap_ms": 1600.0,
    "tts": {
      "backend": "tone",
      "token_ms": 180.0,
      "token_ms_jitter": 30.0,
      "gap_ms": 85.0,
      "lead_ms": 180.0,
      "tail_ms": 200.0,
      "amplitude": 12500.0,
      "pitch_jitter": 0.012
    },
    "augment": {
      "gain_db_min": -5.0,
      "gain_db_max": 3.0,
      "snr_db_min": 5.0,
      "snr_db_max": 36.0,
      "echo_max_ms": 70.0,
      "echo_gain_max": 0.18,
      "noise_profiles": ["white", "fan", "motor", "media"]
    }
  },
  "dataset": {
    "train": {
      "positive_families_per_keyword": 24,
      "confusable_families_per_keyword": 16,
      "random_negative_families": 24,
      "background_seconds_per_profile": 4.0,
      "variants_per_family": 4
    },
    "calibration": {
      "positive_families_per_keyword": 8,
      "confusable_families_per_keyword": 8,
      "random_negative_families": 12,
      "background_seconds_per_profile": 30.0,
      "variants_per_family": 1
    },
    "test": {
      "positive_families_per_keyword": 12,
      "confusable_families_per_keyword": 10,
      "random_negative_families": 16,
      "background_seconds_per_profile": 15.0,
      "variants_per_family": 1
    },
    "qualification": {
      "positive_families_per_keyword": 16,
      "confusable_families_per_keyword": 12,
      "random_negative_families": 20,
      "background_seconds_per_profile": 30.0,
      "variants_per_family": 1
    }
  },
  "domains": {
    "distance_bands": {
      "near": {"distance_m": [0.3, 1.0], "weight": 1.0},
      "mid": {"distance_m": [1.0, 3.0], "weight": 1.5},
      "far": {"distance_m": [3.0, 5.0], "weight": 2.5}
    },
    "azimuth_deg": [-150, -120, -90, -60, -30, 0, 30, 60, 90, 120, 150, 180],
    "rt60_s": [0.15, 0.80],
    "snr_db": [3.0, 30.0],
    "noise_profiles": ["white", "fan", "motor", "media"],
    "mic_spacing_m": 0.06,
    "playback": {
      "probability": 0.35,
      "sir_db": [-8.0, 20.0]
    },
    "afe": {
      "backend": "proxy"
    },
    "scenes_per_example": {
      "train": 2,
      "calibration": 1,
      "test": 2,
      "qualification": 8
    }
  },
  "model": {
    "feature_dim": 32,
    "hidden_dim": 64,
    "frontends": ["logmel"],
    "domain_variants_per_token": 24,
    "prototype_candidates": [
      {"input_scale": 0.010, "output_scale": 0.050, "blank_bias": 1.8, "token_bias": -1.2}
    ]
  },
  "train": {
    "epochs": 36,
    "batch_size": 16,
    "lr": 0.001
  },
  "calibration": {
    "thresholds": [0.55],
    "coordinate_rounds": 1
  },
  "domain_iteration": {
    "backend": "torch_ctc",
    "max_rounds": 3,
    "min_rounds": 3,
    "patience": 3,
    "curriculum_strength": 2.5,
    "max_domain_weight": 6.0,
    "stop_on_gate": false,
    "warm_start_strategy": "full",
    "gate_equivalent_score_epsilon": 0.05,
    "hard_negative_replay": [
      {
        "tokens": ["hao3", "ni3", "xiao3", "wo1"],
        "examples": 24
      },
      {
        "tokens": ["hao3", "hao3", "xiao3", "wo1"],
        "examples": 24
      },
      {
        "tokens": ["hao3", "wo1", "xiao3", "wo1", "ni3"],
        "examples": 48
      }
    ]
  },
  "domain_gates": {
    "max_frr": 0.0,
    "max_far_per_hour": 0.0,
    "max_p95_latency_ms": 800.0,
    "max_far_frr": 0.0
  },
  "robustness_gates": {
    "max_frr": 0.0,
    "max_far_per_hour": 0.0,
    "min_expected_wakes": 4,
    "min_negative_recordings": 4,
    "min_negative_audio_hours": 0.0,
    "required_distance_bins": ["0.5m", "1m", "2m", "3m", "5m"],
    "required_azimuth_deg": [-150, -120, -90, -60, -30, 0, 30, 60, 90, 120, 150, 180],
    "required_snr_bands": ["critical", "low", "mid", "high"],
    "required_stress_slices": [
      "distance_azimuth:distance_bin=5m|azimuth=rear",
      "distance_snr:distance_bin=5m|snr=critical",
      "azimuth_snr:azimuth=rear|snr=critical",
      "distance_azimuth_snr:distance_bin=5m|azimuth=rear|snr=critical"
    ]
  }
}
