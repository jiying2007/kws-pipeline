{
  "schema_version": 1,
  "policy": "kws-v2-staged-experiments-v1",
  "evidence_scope": "development-only",
  "protected_evidence": {
    "fresh_used": false,
    "shadow_used": false,
    "formal_qualification_used": false
  },
  "inputs": {
    "base_config": "configs/training/xiaowo.torch-domain.json",
    "resource_contract": "configs/training/model-family-resource-contract-v1.json",
    "generalization_policy": "configs/training/development-generalization-v1.json",
    "corpus_requirement": "immutable-speech-like-external-base-v1",
    "generalization_tier": "search",
    "require_predeclared_plan": true,
    "development_policies": {
      "rnn": "configs/training/xiaowo.rnn-development-stage-a-v1.json",
      "gru": "configs/training/xiaowo.gru-development-stage-a-v1.json"
    }
  },
  "stage_a_frontend": {
    "enabled": true,
    "selection_mode": "report-only-until-speech-like-baseline-calibrated",
    "families": [
      "rnn",
      "gru"
    ],
    "fixed_feature_dim": 32,
    "fixed_hidden_dim": 64,
    "frontends": [
      "logmel",
      "pcen-lite"
    ],
    "mutable_paths": [
      "model.frontends"
    ],
    "forbidden_simultaneous_mutations": [
      "model.hidden_dim",
      "train",
      "calibration",
      "domain_gates",
      "robustness_gates",
      "development_loop",
      "decoder",
      "threshold"
    ]
  },
  "stage_b_capacity": {
    "enabled": true,
    "depends_on": "stage_a_frontend",
    "requires_frontend_choice": true,
    "selection_mode": "pareto-only-until-target-board-budget",
    "candidates": {
      "rnn": [
        48,
        64
      ],
      "gru": [
        32,
        48,
        64
      ]
    },
    "mutable_paths": [
      "model.hidden_dim"
    ],
    "max_hidden_dim_current_runtime_contract": 64,
    "gru96_requires_separate_runtime_contract_change": true
  },
  "stage_c_loss_ablation": {
    "enabled": false,
    "depends_on": "stage_b_capacity",
    "reason": "activate only after speech-like frontend/capacity baseline is frozen",
    "principle": "one-loss-component-delta-per-experiment",
    "planned_sequence": [
      "ctc-only",
      "ctc-plus-ordered-token",
      "plus-keyword-sequence-margin",
      "plus-strict-prefix-completion",
      "plus-recurrent-release"
    ]
  },
  "invariants": {
    "same_corpus_identity_within_stage": true,
    "same_generalization_plan_within_stage": true,
    "same_threshold_grid_within_stage": true,
    "same_decoder_within_stage": true,
    "same_controller_within_stage": true,
    "single_primary_variable_per_stage": true,
    "protected_feedback_allowed": false,
    "full_training_round_budget_within_stage": true
  }
}
